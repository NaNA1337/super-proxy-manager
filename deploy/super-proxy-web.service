[Unit]
Description=Super-Proxy Web Manager & Control Panel
After=network.target super-proxy.service
Wants=super-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/super-proxy-manager
ExecStart=/root/super-proxy-manager/bin/super-proxy-web -host 127.0.0.1 -port 8443
Restart=always
RestartSec=5s

# Security Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Environment Configuration
Environment="AGENT_API_URL=https://127.0.0.1:60000"
Environment="PORT=8443"
# Environment="XRAY_MANAGER_API_KEY=your-api-key"
# Environment="WEB_ADMIN_PASSWORD=your-secure-admin-password"

[Install]
WantedBy=multi-user.target
