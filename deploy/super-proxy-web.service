[Unit]
Description=Super-Proxy Web Manager & Control Panel
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/super-proxy-manager
ExecStart=/usr/local/bin/super-proxy-web -host 127.0.0.1 -port 8443 -data-dir /var/lib/super-proxy-manager/data
# For loopback/private Agent URLs, append: -allow-private-hosts
Restart=always
RestartSec=5s

# Security Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Environment Configuration (Optional)
# Environment="HOST=127.0.0.1"
# Environment="PORT=8443"
# Environment="DATA_DIR=/var/lib/super-proxy-manager/data"
# Environment="MANAGER_MASTER_KEY=your-32-byte-hex-aes-gcm-master-key"
# ALLOW_PRIVATE_HOSTS=true remains supported for backward compatibility;
# prefer the -allow-private-hosts command argument.

[Install]
WantedBy=multi-user.target
