# Use on a separate IP/server, or choose a different HTTPS port when Xray
# already owns TCP/443 on this host. Example: manager.example.com:9443
manager.example.com {
    tls admin@example.com
    reverse_proxy 127.0.0.1:8443 {
        header_up X-Forwarded-Proto https
    }
    # Access logging is deliberately not enabled: /sub/<token> paths contain
    # subscription credentials. Configure URI redaction before enabling logs.
}
